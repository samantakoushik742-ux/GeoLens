# Copy these values into the Satellite project root .env file.
MYSQL_HOST=image-dataset-db-jha531035-264f.i.aivencloud.com
MYSQL_PORT=21434
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_SSL_CA=ca.pem
DRIVE_FILE_ID=1Q-XIAI7pFoc0X4jUIZfq_Or34V0NHDS8

# Absolute path to the Aiven CA certificate. Leave blank only if your provider
# explicitly supports a non-CA TLS connection.
MYSQL_SSL_CA=C:/path/to/ca.pem

# OAuth files are expected in the Satellite project root.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Optional: ZIP filename inside database_ingestion/
INGEST_ZIP_NAME=dataset.zip
