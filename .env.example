# Flask server. Render supplies PORT; local development defaults to 5000.
HOST=0.0.0.0
PORT=5000

# Comma-separated exact browser origins. Add the production Vercel domain.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-site.vercel.app
# Optional regex for previews, scoped to your Vercel project/team.
CORS_ALLOWED_ORIGIN_REGEX=

# Aiven MySQL. Keep MYSQL_PASSWORD private and provide the CA certificate path.
MYSQL_HOST=
MYSQL_PORT=21434
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL_CA=

# Optional external checkpoint path when deploying outside the repository.
GEOLENS_MODEL_PATH=
